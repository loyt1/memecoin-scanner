{
  "ignoreCommand": "bash vercel-ignore.sh",
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "data": false,
      "backtest": false
    }
  }
}